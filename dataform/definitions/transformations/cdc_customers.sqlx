config {
      type: "table",
        schema: "cdc_layer",
          name: "customers",
            description: "CDC customers - Full Load with clustering optimization",
              tags: ["full_load", "daily"],
                
                  bigquery: {
                      clusterBy: ["country", "customer_type"]
                        },
                          
                            assertions: {
                                uniqueKey: ["customer_id"],
                                    nonNull: ["customer_id", "customer_name", "country"],
                                        rowConditions: [
                                              "credit_limit >= 0",
                                                    "customer_type IN ('Retail', 'Wholesale')"
                                                        ]
                                                          }
                                                          }

                                                          SELECT
                                                            customer_id,
                                                              customer_name,
                                                                city,
                                                                  country,
                                                                    customer_type,
                                                        …                                                       (audit_id, pipeline_name, table_name, load_type, start_time, end_time, duration_seconds, rows_processed, status, error_message, created_by)
                                                                                    SELECT
                                                                                        GENERATE_UUID(),
                                                                                            'cdc_customers',
                                                                                                'cdc_layer.customers',
                                                                                                    'FULL_LOAD',
                                                                                                        CURRENT_TIMESTAMP(),
                                                                                                            CURRENT_TIMESTAMP(),
              …                                                                                      'SUCCESS',
                                                                                                                            NULL,
                                                                                                                                SESSION_USER()
                                                                                                                                }
