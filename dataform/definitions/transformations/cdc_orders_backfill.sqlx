config {
  type: "table",
  schema: "cdc_layer",
  name: "orders_backfill_staging",
  description: "Backfill staging table - holds backfilled orders before merging to main",
  tags: ["backfill", "on_demand"]
}

pre_operations {
  -- Log this backfill execution
  INSERT INTO `project-a2f79f6e-db67-4726-be8.audit_layer.backfill_log`
  (backfill_id, pipeline_name, target_table, backfill_start_date, backfill_end_date,
   reason, requested_by, status, execution_start)
  VALUES
  (GENERATE_UUID(),
   'cdc_orders_backfill',
   'cdc_layer.orders',
   DATE("${dataform.projectConfig.vars.backfill_start_date}"),
   DATE("${dataform.projectConfig.vars.backfill_end_date}"),
   "${dataform.projectConfig.vars.backfill_reason}",
   "${dataform.projectConfig.vars.backfill_requested_by}",
   'IN_PROGRESS',
   CURRENT_TIMESTAMP())
}

-- Main backfill query: deduplicate and filter for the specified date range
WITH backfill_data AS (
  SELECT * EXCEPT(rn)
  FROM (
    SELECT *,
      ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY last_updated DESC) AS rn
    FROM ${ref({schema: "raw_layer", name: "orders"})}
  )
  WHERE order_date BETWEEN DATE("${dataform.projectConfig.vars.backfill_start_date}")
    AND DATE("${dataform.projectConfig.vars.backfill_end_date}")
)

SELECT
  order_id,
  customer_id,
  product_name,
  quantity,
  amount,
  order_date,
  status,
  changetype,
  last_updated,
  CURRENT_TIMESTAMP() AS cdc_processed_at
FROM backfill_data
WHERE changetype != 'D'
